{
  "name": "firecracker-billing",
  "version": "0.1.5",
  "private": true,
  "description": "Offline billing and sales dashboard for a firecracker store",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.firecracker.billing",
    "productName": "Firecracker Billing",
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "src/**/*",
      "build/app-icon.png",
      "package.json"
    ],
    "icon": "build/app-icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/app-icon.png"
    },
    "mac": {
      "icon": "build/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
